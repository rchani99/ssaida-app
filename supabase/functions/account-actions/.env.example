# Server-only. Never copy to EXPO_PUBLIC_* or the mobile bundle.
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in hosted functions.
# Leave disabled until release checks pass. PIN recovery retains its 72-hour delay;
# new deletion requires a server-issued email proof followed by a 14-day grace period.
# Real mail stays disabled until Resend domain, secrets and gateway checks pass.
ACCOUNT_ACTIONS_ENABLED=
# Account deletion requires this flag AND the purge secret below. Install the hourly
# schedule in supabase/snippets/account-deletion-schedule.sql before enabling the flag.
# MVP PIN-only rollout: set this true and keep ACCOUNT_ACTIONS_ENABLED false.
# Allows begin/resume/reset_pin for PIN recovery; deletion and purge remain disabled.
PIN_RECOVERY_ENABLED=
# High-entropy bearer for the scheduled purge route only. Unset disables that route.
# Give it to the scheduler alone; never to the app, and never reuse the service role key.
ACCOUNT_ACTIONS_PURGE_SECRET=
# Optional comma-separated exact web origins (scheme + host + port, no trailing slash).
# Empty means native/server requests only. Never use a wildcard or allow "null".
ACCOUNT_ACTIONS_ALLOWED_ORIGINS=
# Explicit "mock" (local SUPABASE_URL only) or "resend". Empty/unknown fails closed.
# No fallback to mock when Resend credentials are missing or invalid.
ACCOUNT_DELETION_EMAIL_MODE=
# Resend sending-access key restricted to the verified sending domain.
RESEND_API_KEY=
# Single sender on that verified domain, e.g. Ssaida <security@mail.example.com>.
# This does not configure or replace Supabase Auth SMTP.
DELETION_EMAIL_FROM=
# Two DIFFERENT random 32-byte keys, lowercase hex. Never reuse a service-role key.
ACCOUNT_DELETION_EMAIL_HMAC_KEY=
ACCOUNT_DELETION_EMAIL_ENCRYPTION_KEY=
# Independent high-entropy secret (at least 32 characters) for POST /email/send.
# Only a trusted worker should hold it. No schedule is installed by this change.
ACCOUNT_DELETION_MAIL_WORKER_SECRET=
