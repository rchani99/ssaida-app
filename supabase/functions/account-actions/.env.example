# Server-only. Never copy to EXPO_PUBLIC_* or the mobile bundle.
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in hosted functions.
# Leave disabled until the isolated release checks pass. Sensitive actions are authorized by
# a server-recorded waiting period, so no provider client ID or secret is required.
ACCOUNT_ACTIONS_ENABLED=
# Account deletion requires this flag AND the purge secret below. Install the hourly
# schedule in supabase/snippets/account-deletion-schedule.sql before enabling the flag.
# MVP PIN-only rollout: set this true and keep ACCOUNT_ACTIONS_ENABLED false.
# Allows begin/resume/reset_pin for PIN recovery; deletion and purge remain disabled.
PIN_RECOVERY_ENABLED=
# High-entropy bearer for the scheduled purge route only. Unset disables that route.
# Give it to the scheduler alone; never to the app, and never reuse the service role key.
ACCOUNT_ACTIONS_PURGE_SECRET=
