# Choose development or production. Empty values deliberately fail validation.
EXPO_PUBLIC_APP_ENV=
# Development only (existing local .env names are retained).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production only. Never falls back to the development variables above.
EXPO_PUBLIC_PRODUCTION_SUPABASE_URL=
EXPO_PUBLIC_PRODUCTION_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_PRODUCTION_SUPABASE_PROJECT_REF=
# Must be false in production; development is opt-in.
EXPO_PUBLIC_ENABLE_DEV_EMAIL_LOGIN=
# Must match the existing ssaida scheme and auth/callback route.
EXPO_PUBLIC_AUTH_REDIRECT_URI=
