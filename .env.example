# Choose development or production. Empty values deliberately fail validation.
EXPO_PUBLIC_APP_ENV=
# Development only (existing local .env names are retained).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production only. Never falls back to the development variables above.
EXPO_PUBLIC_PRODUCTION_SUPABASE_URL=
EXPO_PUBLIC_PRODUCTION_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_PRODUCTION_SUPABASE_PROJECT_REF=
# Must be false in production; development is opt-in.
EXPO_PUBLIC_ENABLE_DEV_EMAIL_LOGIN=
# Must match the existing ssaida scheme and auth/callback route.
EXPO_PUBLIC_AUTH_REDIRECT_URI=
# DEV opt-in only. Missing/false and all production/release builds hide sensitive action UI.
EXPO_PUBLIC_ENABLE_SENSITIVE_ACCOUNT_ACTIONS=
# Server-only settings (Supabase Edge secrets, NEVER EXPO_PUBLIC or mobile .env):
# ACCOUNT_ACTIONS_ENABLED
# ACCOUNT_ACTIONS_PURGE_SECRET  (scheduler-only bearer for /account-actions/purge)
# Sensitive actions are authorized by a server-recorded waiting period, so no provider
# client ID or secret is involved any more.
